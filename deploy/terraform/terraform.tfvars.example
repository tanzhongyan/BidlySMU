# =============================================================================
# TERRAFORM VARIABLES - EXAMPLE CONFIGURATION
# =============================================================================
# Copy this file to terraform.tfvars and fill in your values
# =============================================================================

# AWS Configuration
aws_region   = "ap-southeast-1"
environment  = "staging"
project_name = "bidlysmu"

# =============================================================================
# VPC / NETWORKING
# =============================================================================
# Option 1: Use existing VPC (recommended - use default VPC for free tier)
create_vpc          = false
vpc_name            = "default"
security_group_name = "default"

# Option 2: Create new VPC (for testing/dev - costs ~$30/month for NAT Gateway)
# create_vpc = true
# vpc_cidr   = "10.0.0.0/16"

# =============================================================================
# ECS CONFIGURATION
# =============================================================================
# CPU and memory for pipeline task
# Options: 256, 512, 1024, 2048, 4096 (CPU)
# Memory must be compatible with CPU: https://docs.aws.amazon.com/AmazonECS/latest/developerguide/task-cpu-memory-error.html
ecs_cpu           = 2048
ecs_memory        = 4096
pipeline_image_tag = "v1.0.0"

# ECS container name (used for environment variable overrides)
ecs_container_name = "bidlysmu-pipeline"

# =============================================================================
# LAMBDA CONFIGURATION
# =============================================================================
# Lambda now uses Truba JSON API (no Selenium required)
# Lightweight - only needs requests, supabase, boto3
lambda_memory       = 512
lambda_timeout      = 300
scheduler_image_tag = "v1.0.0"

# =============================================================================
# TRUBA API CONFIGURATION
# =============================================================================
# Truba JSON API for SMU calendar (public, no authentication)
truba_api_url   = "https://www.trumba.com/calendars/SMU_RO_Acad.json"
months_ahead    = 12

# =============================================================================
# EVENTBRIDGE SCHEDULER
# =============================================================================
# Monthly cron: 1st of each month at 8am SGT (00:00 UTC)
monthly_schedule_cron = "cron(0 0 1 * ? *)"

# =============================================================================
# SECRETS MANAGER
# =============================================================================
# These secrets must exist before running terraform apply
# Create them via AWS Console or CLI:
#
# aws secretsmanager create-secret --name bidlysmu-db-credentials --secret-string '{"DB_HOST":"...","DB_NAME":"...","DB_USER":"...","DB_PASSWORD":"...","DB_PORT":"5432"}'
# aws secretsmanager create-secret --name bidlysmu-boss-credentials --secret-string '{"email":"...","password":"...","mfa_secret":"..."}'
# aws secretsmanager create-secret --name bidlysmu-api-keys --secret-string '{"gemini_api_key":"...","supabase_url":"...","supabase_service_key":"...","sentry_dsn":"..."}'

db_secret_name       = "bidlysmu-db-credentials"
boss_secret_name     = "bidlysmu-boss-credentials"
api_keys_secret_name = "bidlysmu-api-keys"

# =============================================================================
# SUPABASE
# =============================================================================
# Supabase URL (can also be stored in secrets)
supabase_url = "https://your-project.supabase.co"