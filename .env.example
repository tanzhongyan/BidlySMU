# Local DB connection details
DB_HOST=localhost
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=changeme
DB_PORT=5433

# Staging DB (used by scripts/check_staging.py)
STAGING_DB_HOST=<REPLACE WITH STAGING HOST>
STAGING_DB_PORT=5432
STAGING_DB_NAME=postgres
STAGING_DB_USER=<REPLACE WITH STAGING USER>
STAGING_DB_PASSWORD=<REPLACE WITH STAGING PASSWORD>

# Production DB (used by scripts/copy_prod_tables.py)
PROD_DB_HOST=<REPLACE WITH PROD HOST>
PROD_DB_PORT=5432
PROD_DB_NAME=postgres
PROD_DB_USER=<REPLACE WITH PROD USER>
PROD_DB_PASSWORD=<REPLACE WITH PROD PASSWORD>

# Google gemini 2.5 flash
GEMINI_API_KEY=<REPLACE WITH KEY FROM AI STUDIO>

# SMU BOSS Automated Login Credentials
# For automated login with TOTP-based MFA (optional - can also pass to perform_automated_login())
BOSS_EMAIL=<REPLACE WITH SCHOOL EMAIL>
BOSS_PASSWORD=<REPLACE WITH SCHOOL PASSWORD>
# MFA Secret: Base32 encoded secret from Microsoft Authenticator app setup
# To get this: Go to Microsoft Authenticator > SMU account > Set up > "Can't scan?" > copy the secret key
BOSS_MFA_SECRET=<REPLACE WITH MFA SECRET>

# Academic Term ID in BOSS format (e.g., AY202526T3A = AY 2025/26, Term 3A)
ACAD_TERM_ID=AY202526T3A

# Sentry
SENTRY_DSN=<REPLACE WITH SENTRY DSN>

# Supabase
SUPABASE_URL=<REPLACE WITH SUPABASE URL>
SUPABASE_SERVICE_KEY=<REPLACE WITH SERVICE_ROLE KEY>
SUPABASE_ANON_KEY=<REPLACE WITH ANON KEY>
